<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PayControl</AssemblyName>
    <RootNamespace>PayControl.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PayControl</Product>
    <Description>Personel Mali Denetim Sistemi</Description>
  </PropertyGroup>

  <!-- Linux CI: Desktop atlanır -->
  <PropertyGroup Condition="'$(ExcludeDesktop)' == 'true'">
    <TargetFramework>net8.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <OutputType>Library</OutputType>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup Condition="'$(ExcludeDesktop)' != 'true'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <ProjectReference Include="..\PayControl.Application\PayControl.Application.csproj" />
    <ProjectReference Include="..\PayControl.Infrastructure\PayControl.Infrastructure.csproj" />
    <ProjectReference Include="..\PayControl.Domain\PayControl.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExcludeDesktop)' == 'true'">
    <Compile Include="Placeholder.cs" />
  </ItemGroup>

</Project>
