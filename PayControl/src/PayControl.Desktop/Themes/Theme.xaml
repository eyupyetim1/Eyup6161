<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PayControl.Desktop.Converters"
                    xmlns:ctl="clr-namespace:PayControl.Desktop.Controls">

    <!-- =====================================================================
         PayControl tasarım sistemi
         Tokenlar → tipografi → efektler → dönüştürücüler → kontrol şablonları
         ===================================================================== -->

    <!-- Renk tokenları -->
    <Color x:Key="BirincilRenk">#2563EB</Color>
    <Color x:Key="NavyColor">#0F1E36</Color>

    <SolidColorBrush x:Key="BirincilBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="BirincilKoyuBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BirincilYumusakBrush" Color="#EFF4FF"/>
    <SolidColorBrush x:Key="OdakHalkaBrush" Color="#402563EB"/>

    <SolidColorBrush x:Key="ZeminBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="YuzeyBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="YuzeyIkincilBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="KenarBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="KenarKoyuBrush" Color="#C9D1DC"/>
    <SolidColorBrush x:Key="SatirCizgiBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="HoverSatirBrush" Color="#F6F9FF"/>
    <SolidColorBrush x:Key="SeciliSatirBrush" Color="#E8F0FE"/>

    <SolidColorBrush x:Key="YaziBrush" Color="#101828"/>
    <SolidColorBrush x:Key="IkincilYaziBrush" Color="#475467"/>
    <SolidColorBrush x:Key="SolukYaziBrush" Color="#98A2B3"/>

    <SolidColorBrush x:Key="BasariBrush" Color="#17B26A"/>
    <SolidColorBrush x:Key="BasariYumusakBrush" Color="#ECFDF3"/>
    <SolidColorBrush x:Key="UyariRenkBrush" Color="#F79009"/>
    <SolidColorBrush x:Key="UyariYumusakBrush" Color="#FFFAEB"/>
    <SolidColorBrush x:Key="TehlikeBrush" Color="#F04438"/>
    <SolidColorBrush x:Key="TehlikeYumusakBrush" Color="#FEF3F2"/>
    <SolidColorBrush x:Key="MorBrush" Color="#7A5AF8"/>
    <SolidColorBrush x:Key="MorYumusakBrush" Color="#F4F3FF"/>

    <LinearGradientBrush x:Key="MenuArkaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1628" Offset="0"/>
        <GradientStop Color="#13274A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MarkaGradyanBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7A5AF8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GirisArkaBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1628" Offset="0"/>
        <GradientStop Color="#1E3A8A" Offset="0.6"/>
        <GradientStop Color="#4338CA" Offset="1"/>
    </LinearGradientBrush>

    <!-- Geriye dönük anahtarlar (eski ekranlar ve kodlar bu adları kullanır) -->
    <SolidColorBrush x:Key="NavyBrush" Color="#0F1E36"/>
    <SolidColorBrush x:Key="NavyLightBrush" Color="#1E3A66"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#101828"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#B54708"/>
    <SolidColorBrush x:Key="OkBrush" Color="#067647"/>

    <!-- Tipografi -->
    <FontFamily x:Key="AnaFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="BaslikFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="IkonFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Efektler -->
    <DropShadowEffect x:Key="GolgeHafif" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#101828"/>
    <DropShadowEffect x:Key="GolgeOrta" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.14" Color="#101828"/>
    <DropShadowEffect x:Key="GolgeBirincil" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#2563EB"/>

    <!-- Dönüştürücüler -->
    <conv:DurumRozetiConverter x:Key="Rozet"/>
    <conv:BasHarfConverter x:Key="BasHarf"/>
    <conv:TutarRengiConverter x:Key="TutarRengi"/>
    <conv:GorunurlukConverter x:Key="Gorunurluk"/>
    <BooleanToVisibilityConverter x:Key="BoolGorunur"/>
    <conv:YerelZamanConverter x:Key="YerelZaman"/>
    <conv:TersBoolConverter x:Key="TersBool"/>

    <!-- =================================================================== Tipografi stilleri -->
    <Style x:Key="SayfaBasligi" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BaslikFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
    </Style>
    <Style x:Key="AltBaslik" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="BolumBasligi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="AlanEtiketi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource IkincilYaziBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="IkonYazi" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IkonFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MesajYazi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource BirincilKoyuBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- =================================================================== Yüzeyler -->
    <Style x:Key="Kart" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <!-- Küçük kartlar için gölgeli sürüm (büyük tablolarda gölge kaydırmayı yavaşlatır) -->
    <Style x:Key="GolgeliKart" TargetType="Border" BasedOn="{StaticResource Kart}">
        <Setter Property="Effect" Value="{StaticResource GolgeHafif}"/>
    </Style>
    <Style x:Key="IcKart" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource YuzeyIkincilBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- Bilgi şeridi (mesaj alanı) -->
    <Style x:Key="BilgiSeridi" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BirincilYumusakBrush}"/>
        <Setter Property="BorderBrush" Value="#C7D7FE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style x:Key="UyariSeridi" TargetType="Border" BasedOn="{StaticResource BilgiSeridi}">
        <Setter Property="Background" Value="{StaticResource UyariYumusakBrush}"/>
        <Setter Property="BorderBrush" Value="#FEDF89"/>
    </Style>

    <!-- =================================================================== Butonlar -->
    <Style x:Key="TemelButon" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="Foreground" Value="#344054"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarKoyuBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="kok" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="olcek" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="odak" CornerRadius="11" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource OdakHalkaBrush}" Opacity="0"/>
                        <Border x:Name="zemin" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="parlama" CornerRadius="8" Background="{TemplateBinding Foreground}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="parlama" Storyboard.TargetProperty="Opacity" To="0.09" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="parlama" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="olcek" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="olcek" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="parlama" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="olcek" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="olcek" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="parlama" Storyboard.TargetProperty="Opacity" To="0.09" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="odak" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="kok" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Varsayılan buton = ikincil -->
    <Style TargetType="Button" BasedOn="{StaticResource TemelButon}"/>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource TemelButon}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#98A2B3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TemelButon}">
        <Setter Property="Background" Value="{StaticResource BirincilBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BirincilKoyuBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Effect" Value="{StaticResource GolgeBirincil}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource TemelButon}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BirincilBrush}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource TemelButon}">
        <Setter Property="Background" Value="#D92D20"/>
        <Setter Property="BorderBrush" Value="#B42318"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="BasariButton" TargetType="Button" BasedOn="{StaticResource TemelButon}">
        <Setter Property="Background" Value="#079455"/>
        <Setter Property="BorderBrush" Value="#067647"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Yan menü butonu -->
    <Style x:Key="MenuButon" TargetType="Button">
        <Setter Property="Foreground" Value="#B7C3D7"/>
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="zemin" CornerRadius="10" Background="White" Opacity="0"/>
                        <Border x:Name="serit" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9"
                                Background="{StaticResource MarkaGradyanBrush}" Opacity="0"/>
                        <ContentPresenter Margin="14,10" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="zemin" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="zemin" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="zemin" Property="Opacity" Value="0.14"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="secili">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="serit" Property="Opacity" Value="1"/>
                            <Setter TargetName="zemin" Property="Opacity" Value="0.10"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== Metin kutuları -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarKoyuBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource BirincilBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BirincilBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="halka" CornerRadius="11" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource OdakHalkaBrush}" Opacity="0"/>
                        <Border x:Name="kenar" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="ipucu" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource SolukYaziBrush}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ipucu" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="#98A2B3"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="kenar" Property="Background" Value="{StaticResource YuzeyIkincilBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="halka" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="halka" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Arama kutusu: solda büyüteç ikonu -->
    <Style x:Key="AramaKutusu" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="36,8,10,8"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="halka" CornerRadius="13" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource OdakHalkaBrush}" Opacity="0"/>
                        <Border x:Name="kenar" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IkonFont}" FontSize="14" Margin="12,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource SolukYaziBrush}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="ipucu" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource SolukYaziBrush}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ipucu" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="#98A2B3"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="halka" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarKoyuBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource BirincilBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="halka" CornerRadius="11" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource OdakHalkaBrush}" Opacity="0"/>
                        <Border x:Name="kenar" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="#98A2B3"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="halka" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== ComboBox -->
    <ControlTemplate x:Key="ComboOkSablonu" TargetType="ToggleButton">
        <Border x:Name="kenar" CornerRadius="8" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Path x:Name="ok" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                  Data="M0,0 L4.5,4.5 L9,0" Stroke="{StaticResource IkincilYaziBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="don" Angle="0"/>
                </Path.RenderTransform>
            </Path>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kenar" Property="BorderBrush" Value="#98A2B3"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="kenar" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                <Setter TargetName="ok" Property="Stroke" Value="{StaticResource BirincilBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="don" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="don" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarKoyuBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="halka" CornerRadius="11" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource OdakHalkaBrush}" Opacity="0"/>
                        <ToggleButton x:Name="dugme" Focusable="False" ClickMode="Press" Template="{StaticResource ComboOkSablonu}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="icerik" IsHitTestVisible="False" Margin="12,0,34,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" VerticalOffset="2" HorizontalOffset="-8">
                            <Border Margin="8,2,8,14" Background="{StaticResource YuzeyBrush}" BorderBrush="{StaticResource KenarBrush}"
                                    BorderThickness="1" CornerRadius="10" Effect="{StaticResource GolgeOrta}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="halka" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="zemin" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="zemin" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="zemin" Property="Background" Value="{StaticResource BirincilYumusakBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BirincilKoyuBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== DatePicker -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BirincilBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="TakvimDugmeSablonu" TargetType="Button">
        <Border x:Name="z" Background="Transparent" CornerRadius="6" Margin="2">
            <TextBlock x:Name="ikon" Text="&#xE787;" FontFamily="{StaticResource IkonFont}" FontSize="14"
                       Foreground="{StaticResource IkincilYaziBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="z" Property="Background" Value="{StaticResource BirincilYumusakBrush}"/>
                <Setter TargetName="ikon" Property="Foreground" Value="{StaticResource BirincilBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarKoyuBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="SelectedDateFormat" Value="Short"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="halka" CornerRadius="11" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource OdakHalkaBrush}" Opacity="0"/>
                        <Border x:Name="kenar" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Padding="10,6,4,6" VerticalContentAlignment="Center"
                                                   Background="Transparent" BorderThickness="0"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Width="32" Focusable="False" Cursor="Hand"
                                        Template="{StaticResource TakvimDugmeSablonu}"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=kenar}" VerticalOffset="4"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="#98A2B3"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="kenar" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="halka" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Ellipse x:Name="daire" Width="18" Height="18" Fill="{StaticResource YuzeyBrush}" Stroke="{StaticResource KenarKoyuBrush}" StrokeThickness="1.5"/>
                            <Ellipse x:Name="nokta" Width="8" Height="8" Fill="White" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="daire" Property="Stroke" Value="{StaticResource BirincilBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="daire" Property="Fill" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="daire" Property="Stroke" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="nokta" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{StaticResource BirincilBrush}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyIkincilBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border x:Name="halka" Width="24" Height="24" CornerRadius="8" BorderThickness="3"
                                    BorderBrush="{StaticResource OdakHalkaBrush}" Opacity="0"/>
                            <Border x:Name="kutu" Width="18" Height="18" CornerRadius="5" Background="{StaticResource YuzeyBrush}"
                                    BorderBrush="{StaticResource KenarKoyuBrush}" BorderThickness="1.5">
                                <Grid>
                                    <Path x:Name="isaret" Data="M3.5,8.5 L7,12 L13.5,4.5" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                                    <Rectangle x:Name="cizgi" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="White" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kutu" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="kutu" Property="Background" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="kutu" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="isaret" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="isaret" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="kutu" Property="Background" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="kutu" Property="BorderBrush" Value="{StaticResource BirincilBrush}"/>
                            <Setter TargetName="cizgi" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="halka" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SatirCizgiBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="MinRowHeight" Value="40"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.ColumnSpan="2"
                                                                        Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical"
                                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Orientation="Horizontal"
                                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource IkincilYaziBrush}"/>
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="zemin" Background="{TemplateBinding Background}" BorderBrush="{StaticResource KenarBrush}"
                                BorderThickness="0,0,0,1" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="siralama" Margin="6,0,0,0" Width="8" Height="5" Stretch="Fill" VerticalAlignment="Center"
                                      Data="M0,5 L4,0 L8,5 Z" Fill="{StaticResource BirincilBrush}" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/>
                            </StackPanel>
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="zemin" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="siralama" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="siralama" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="siralama" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverSatirBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SeciliSatirBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="12,6" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Kritik satırlar için hazır satır stili (DataTrigger pencerede eklenir) -->
    <Style x:Key="SagaHizali" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="TutarHucre" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource TutarRengi}}"/>
    </Style>
    <Style x:Key="SarilanHucre" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style x:Key="SolukHucre" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- =================================================================== Sekmeler -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,12,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource KenarBrush}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,-1" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource IkincilYaziBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,2,0">
                        <Border x:Name="zemin" CornerRadius="8,8,0,0" Background="Transparent" Padding="14,10" Margin="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="cizgi" Height="2.5" VerticalAlignment="Bottom" CornerRadius="2" Margin="8,0"
                                Background="{StaticResource BirincilBrush}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="zemin" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BirincilKoyuBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="zemin" Property="Background" Value="Transparent"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="cizgi" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="cizgi" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== Expander -->
    <ControlTemplate x:Key="ExpanderBaslikSablonu" TargetType="ToggleButton">
        <Border x:Name="z" Background="Transparent" CornerRadius="10" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="ok" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource IkincilYaziBrush}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="don" Angle="0"/>
                    </Path.RenderTransform>
                </Path>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="z" Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ok" Property="Stroke" Value="{StaticResource BirincilBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="don" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="don" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Expander">
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="Foreground" Value="{StaticResource YaziBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{StaticResource YuzeyBrush}" BorderBrush="{StaticResource KenarBrush}" BorderThickness="1" CornerRadius="12">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Template="{StaticResource ExpanderBaslikSablonu}" Cursor="Hand"
                                          Content="{TemplateBinding Header}" FontWeight="SemiBold"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="icerik" Margin="14,0,14,14" Visibility="Collapsed"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="icerik" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== Kaydırma çubukları -->
    <Style x:Key="ScrollSayfaDugmesi" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollTutamac" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" CornerRadius="4" Background="#C9D1DC" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#98A2B3"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#667085"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DikeyScrollSablonu" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollSayfaDugmesi}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollTutamac}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollSayfaDugmesi}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="YatayScrollSablonu" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollSayfaDugmesi}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollTutamac}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollSayfaDugmesi}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="MinWidth" Value="11"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource DikeyScrollSablonu}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="MinHeight" Value="11"/>
                <Setter Property="Template" Value="{StaticResource YatayScrollSablonu}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =================================================================== ToolTip, ListBox -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#101828" CornerRadius="8" Padding="10,7" Margin="6" MaxWidth="380" Effect="{StaticResource GolgeOrta}">
                        <ContentPresenter TextElement.Foreground="White">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource YuzeyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KenarBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontFamily" Value="{StaticResource AnaFont}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="z" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="z" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="z" Property="Background" Value="{StaticResource BirincilYumusakBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== Özel bileşenler -->
    <!-- Durum rozeti: Tag'e enum/bool verilir -->
    <Style x:Key="RozetKenar" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,3,10,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource Rozet}, ConverterParameter=arka}"/>
    </Style>

    <!-- Rozet şablonu: ContentControl.Content = enum/bool değeri, ContentTemplate = bu şablon -->
    <DataTemplate x:Key="RozetSablonu">
        <Border CornerRadius="999" Padding="8,3,10,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                Background="{Binding Converter={StaticResource Rozet}, ConverterParameter=arka}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                         Fill="{Binding Converter={StaticResource Rozet}, ConverterParameter=nokta}"/>
                <TextBlock Text="{Binding Converter={StaticResource Rozet}, ConverterParameter=metin}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{Binding Converter={StaticResource Rozet}, ConverterParameter=yazi}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Avatar (baş harfler) -->
    <DataTemplate x:Key="AvatarSablonu">
        <Grid Width="32" Height="32">
            <Ellipse Fill="{StaticResource BirincilYumusakBrush}"/>
            <TextBlock Text="{Binding Converter={StaticResource BasHarf}}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource BirincilKoyuBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- KPI kartı -->
    <Style TargetType="ctl:KpiKarti">
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Vurgu" Value="{StaticResource BirincilBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:KpiKarti">
                    <Grid x:Name="kok" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="kaydir" Y="0"/>
                        </Grid.RenderTransform>
                        <Border x:Name="kart" Background="{StaticResource YuzeyBrush}" BorderBrush="{StaticResource KenarBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="16,14" Effect="{StaticResource GolgeHafif}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="38" Height="38" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <Border CornerRadius="10" Background="{TemplateBinding Vurgu}" Opacity="0.12"/>
                                    <TextBlock Text="{TemplateBinding Ikon}" FontFamily="{StaticResource IkonFont}" FontSize="16"
                                               Foreground="{TemplateBinding Vurgu}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{TemplateBinding Baslik}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{TemplateBinding Deger}" FontFamily="{StaticResource BaslikFont}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource YaziBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="alt" Text="{TemplateBinding AltBilgi}" FontSize="11.5" Foreground="{StaticResource SolukYaziBrush}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AltBilgi" Value="{x:Null}">
                            <Setter TargetName="alt" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kart" Property="Effect" Value="{StaticResource GolgeOrta}"/>
                            <Setter TargetName="kart" Property="BorderBrush" Value="#D0D9E6"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="kaydir" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="kaydir" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Adım göstergesi öğesi (ödeme kontrol / dönem durumu) -->
    <DataTemplate x:Key="AsamaSablonu">
        <StackPanel Orientation="Horizontal" Margin="0,0,6,0" ToolTip="{Binding Aciklama}">
            <Grid Width="26" Height="26">
                <Ellipse x:Name="daire" Fill="{StaticResource YuzeyBrush}" Stroke="{StaticResource KenarKoyuBrush}" StrokeThickness="1.5"/>
                <TextBlock x:Name="no" Text="{Binding No}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="tik" Text="&#xE73E;" FontFamily="{StaticResource IkonFont}" FontSize="11" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="ad" Text="{Binding Ad}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource MutedBrush}"/>
            <Border x:Name="baglanti" Width="28" Height="2" CornerRadius="1" Margin="10,0,4,0" VerticalAlignment="Center" Background="{StaticResource KenarBrush}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Durum}" Value="tamam">
                <Setter TargetName="daire" Property="Fill" Value="{StaticResource BasariBrush}"/>
                <Setter TargetName="daire" Property="Stroke" Value="{StaticResource BasariBrush}"/>
                <Setter TargetName="no" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="tik" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ad" Property="Foreground" Value="{StaticResource YaziBrush}"/>
                <Setter TargetName="baglanti" Property="Background" Value="{StaticResource BasariBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Durum}" Value="aktif">
                <Setter TargetName="daire" Property="Fill" Value="{StaticResource BirincilBrush}"/>
                <Setter TargetName="daire" Property="Stroke" Value="{StaticResource BirincilBrush}"/>
                <Setter TargetName="no" Property="Foreground" Value="White"/>
                <Setter TargetName="ad" Property="Foreground" Value="{StaticResource BirincilKoyuBrush}"/>
                <Setter TargetName="ad" Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Son}" Value="True">
                <Setter TargetName="baglanti" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
