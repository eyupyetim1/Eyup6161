<Window x:Class="PayControl.Desktop.Views.UyariMerkeziWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PayControl.Desktop.Controls"
        Title="Uyarı Merkezi"
        Height="780" Width="1280" MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}">
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="190" ItemsSource="{Binding Tesisler}" SelectedItem="{Binding SeciliTesis}" Margin="0,0,8,0" ToolTip="Tesis"/>
                <ComboBox Width="110" ItemsSource="{Binding Seviyeler}" SelectedItem="{Binding SeciliSeviye}" Margin="0,0,8,0" ToolTip="Seviye"/>
                <ComboBox Width="170" ItemsSource="{Binding Kategoriler}" SelectedItem="{Binding SeciliKategori}" Margin="0,0,8,0" ToolTip="Kategori"/>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding YenileCommand}" ToolTip="Yenile">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IkonYazi}" FontSize="13"/>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Uyarı merkezi" Style="{StaticResource SayfaBasligi}"/>
                <TextBlock Style="{StaticResource AltBaslik}" Text="Tüm modüllerdeki açık işler tek listede: kapanış, mutabakat, avans, çıkış, icra, yedek, bildirim"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-12,14">
            <ctl:KpiKarti Baslik="Kritik" Deger="{Binding Kritik}" Ikon="&#xE783;" Vurgu="{StaticResource TehlikeBrush}" AltBilgi="Hemen ilgilenilmeli"/>
            <ctl:KpiKarti Baslik="Uyarı" Deger="{Binding UyariSayisi}" Ikon="&#xE7BA;" Vurgu="{StaticResource UyariRenkBrush}" AltBilgi="Dönem kapanmadan çözülmeli"/>
            <ctl:KpiKarti Baslik="Bilgi" Deger="{Binding Bilgi}" Ikon="&#xE946;" Vurgu="{StaticResource BirincilBrush}" AltBilgi="Takip için"/>
        </UniformGrid>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource BilgiSeridi}" Margin="0,12,0,0" Visibility="{Binding Mesaj, Converter={StaticResource Gorunurluk}}">
            <TextBlock Text="{Binding Mesaj}" Style="{StaticResource MesajYazi}"/>
        </Border>
        <Border Style="{StaticResource Kart}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding PersonelAcCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Personel kartını aç"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Uyarilar.Count, StringFormat={}{0} uyarı listeleniyor}" Style="{StaticResource BolumBasligi}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Uyarilar}" SelectedItem="{Binding SeciliUyari}" IsReadOnly="True" BorderThickness="0,1,0,0" MinRowHeight="46"
                          MouseDoubleClick="Grid_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Seviye" Width="100" SortMemberPath="Seviye">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><ContentControl Content="{Binding Seviye}" ContentTemplate="{StaticResource RozetSablonu}" Focusable="False"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="130" ElementStyle="{StaticResource SolukHucre}"/>
                        <DataGridTemplateColumn Header="Uyarı" Width="3*" SortMemberPath="Baslik">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Aciklama}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tesis" Binding="{Binding Tesis}" Width="*"/>
                        <DataGridTextColumn Header="Dönem" Binding="{Binding Donem}" Width="80"/>
                        <DataGridTextColumn Header="Ne yapılmalı" Binding="{Binding Eylem}" Width="1.6*" ElementStyle="{StaticResource SarilanHucre}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
