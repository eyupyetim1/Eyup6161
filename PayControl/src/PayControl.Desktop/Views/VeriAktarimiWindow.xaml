<Window x:Class="PayControl.Desktop.Views.VeriAktarimiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veri Aktarımı (Access)"
        Height="640" Width="900" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}">
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Excel/Access sisteminden veri aktarımı" Style="{StaticResource SayfaBasligi}"/>
            <TextBlock Style="{StaticResource AltBaslik}" TextWrapping="Wrap"
                       Text="Eski Personel Yönetim Sistemi'nin Access veritabanını (Database.accdb) seçin. Tesisler, personel kartları, tüm puantaj günleri, puantaj notları, aylık özetler, nakiller ve kişisel izin ayarları aktarılır. Tekrar çalıştırılabilir; kayıtlar çoğalmaz."/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Kart}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Access dosyası" Style="{StaticResource AlanEtiketi}"/>
                <DockPanel Margin="0,4,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding KlasorSecCommand}" Content="CSV klasörü…" Margin="6,0,0,0"
                            ToolTip="Access sürücüsü olmayan bilgisayarda: başka yerde CSV'ye çıkarılmış klasörü seçin"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding DosyaSecCommand}" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Dosya seç"/>
                        </StackPanel>
                    </Button>
                    <TextBox Text="{Binding Dosya}" IsReadOnly="True" Tag="Database.accdb"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AktarCommand}" IsEnabled="{Binding Calisiyor, Converter={StaticResource TersBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Aktarımı başlat"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Aktarılıyor… (büyük veritabanında birkaç dakika sürebilir)" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding Calisiyor, Converter={StaticResource BoolGorunur}}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource BilgiSeridi}" Margin="0,0,0,12" Visibility="{Binding Sonuc, Converter={StaticResource Gorunurluk}}">
            <TextBlock Text="{Binding Sonuc}" Style="{StaticResource MesajYazi}" FontWeight="SemiBold"/>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource UyariSeridi}" Margin="0,0,0,12" Visibility="{Binding Mesaj, Converter={StaticResource Gorunurluk}}">
            <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap"/>
        </Border>
        <Border Style="{StaticResource Kart}" Padding="0">
            <ListBox ItemsSource="{Binding Ayrintilar}" BorderThickness="0" Padding="12">
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
