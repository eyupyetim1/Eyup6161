<Window x:Class="PayControl.Desktop.Views.TesislerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tesisler"
        Height="800" Width="1320" MinHeight="580" MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}">
    <Window.Resources>
        <Style x:Key="FormSatiri" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Tesisler" Style="{StaticResource SayfaBasligi}"/>
            <TextBlock Style="{StaticResource AltBaslik}" Text="Birden fazla tesisi ayrı ayrı yönetin: ödeme kontrolü, mutabakat, onay ve raporlar tesis bazında"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource BilgiSeridi}" Margin="0,12,0,0" Visibility="{Binding Mesaj, Converter={StaticResource Gorunurluk}}">
            <TextBlock Text="{Binding Mesaj}" Style="{StaticResource MesajYazi}"/>
        </Border>
        <TabControl SelectedIndex="{Binding SeciliSekme}">
            <TabItem Header="Tesis tanımları">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Kart}" Padding="0" Margin="0,0,14,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding EksikleriOlusturCommand}" Margin="0,0,8,0"
                                            ToolTip="Personel kartlarındaki işyeri adlarından eksik tesisleri oluşturur">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Personelden oluştur"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding YeniCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Yeni tesis"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding Tesisler.Count, StringFormat={}{0} tesis}" Style="{StaticResource BolumBasligi}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Tesisler}" SelectedItem="{Binding SeciliTesis}" IsReadOnly="True" BorderThickness="0,1,0,0" MinRowHeight="48">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kod" Binding="{Binding Tesis.Kod}" Width="70" ElementStyle="{StaticResource SolukHucre}"/>
                                    <DataGridTemplateColumn Header="Tesis" Width="2*" SortMemberPath="Tesis.Ad">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Tesis.Ad}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Tesis.Sirket}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Sorumlu" Binding="{Binding Tesis.SorumluAdSoyad}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Aktif personel" Binding="{Binding AktifPersonel}" Width="100" ElementStyle="{StaticResource SagaHizali}"/>
                                    <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamPersonel}" Width="70" ElementStyle="{StaticResource SagaHizali}"/>
                                    <DataGridTextColumn Header="Aktif maaş toplamı" Binding="{Binding AktifMaasToplami, StringFormat=N2}" Width="140" ElementStyle="{StaticResource TutarHucre}"/>
                                    <DataGridTemplateColumn Header="Aktif" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><ContentControl Content="{Binding Tesis.Aktif}" ContentTemplate="{StaticResource RozetSablonu}" Focusable="False"/></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Kart}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Form}">
                                <TextBlock Text="Tesis bilgileri" Style="{StaticResource BolumBasligi}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kod" Style="{StaticResource AlanEtiketi}"/>
                                        <TextBox Text="{Binding Kod}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ad (personel kartındaki işyeri adı)" Style="{StaticResource AlanEtiketi}"/>
                                        <TextBox Text="{Binding Ad}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Style="{StaticResource FormSatiri}">
                                    <TextBlock Text="Şirket" Style="{StaticResource AlanEtiketi}"/>
                                    <TextBox Text="{Binding Sirket}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormSatiri}">
                                    <TextBlock Text="Adres" Style="{StaticResource AlanEtiketi}"/>
                                    <TextBox Text="{Binding Adres}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormSatiri}">
                                    <TextBlock Text="Sorumlu" Style="{StaticResource AlanEtiketi}"/>
                                    <TextBox Text="{Binding SorumluAdSoyad}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormSatiri}">
                                    <TextBlock Text="Sorumlu e-posta" Style="{StaticResource AlanEtiketi}"/>
                                    <TextBox Text="{Binding SorumluEposta}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormSatiri}">
                                    <TextBlock Text="Sorumlu telefon" Style="{StaticResource AlanEtiketi}"/>
                                    <TextBox Text="{Binding SorumluTelefon}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox Content="Aktif" IsChecked="{Binding Aktif}" Margin="0,0,0,14"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.KaydetCommand, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Kaydet"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Dönem tesis onayları">
                <Border Style="{StaticResource Kart}" Padding="0" Margin="0,14,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox Width="64" Text="{Binding DonemYil}" ToolTip="Yıl"/>
                                <TextBox Width="44" Margin="4,0,8,0" Text="{Binding DonemAy}" ToolTip="Ay"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DonemYukleCommand}" ToolTip="Yükle">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IkonYazi}" FontSize="13"/>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tesis bazında dönem durumu" Style="{StaticResource BolumBasligi}"/>
                                    <TextBlock Text="{Binding OnayOzeti}" Foreground="{StaticResource MutedBrush}" Margin="10,1,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Her tesis sorumlusu kendi bordro/ödeme farkını inceleyip onaylar; tüm tesisler onaylanmadan dönem kapanışı tamamlanmaz."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BasariButton}" Command="{Binding OnaylaCommand}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FB;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Seçili tesisi onayla"/>
                                </StackPanel>
                            </Button>
                            <TextBox Text="{Binding OnayNotu}" Tag="Onay notu (isteğe bağlı)"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding DonemDurumu}" SelectedItem="{Binding SeciliDurum}" IsReadOnly="True" BorderThickness="0,1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tesis" Binding="{Binding Tesis}" Width="1.6*"/>
                                <DataGridTextColumn Header="Bordro satırı" Binding="{Binding BordroSatiri}" Width="100" ElementStyle="{StaticResource SagaHizali}"/>
                                <DataGridTextColumn Header="Bordro net" Binding="{Binding BordroNet, StringFormat=N2}" Width="130" ElementStyle="{StaticResource TutarHucre}"/>
                                <DataGridTextColumn Header="Ödenen" Binding="{Binding Odenen, StringFormat=N2}" Width="130" ElementStyle="{StaticResource TutarHucre}"/>
                                <DataGridTemplateColumn Header="Fark" Width="120" SortMemberPath="Fark">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Fark, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Foreground="{Binding Fark, Converter={StaticResource TutarRengi}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kritik uyarı" Binding="{Binding KritikUyari}" Width="90" ElementStyle="{StaticResource SagaHizali}"/>
                                <DataGridTextColumn Header="Açık fark" Binding="{Binding AcikFark}" Width="80" ElementStyle="{StaticResource SagaHizali}"/>
                                <DataGridTemplateColumn Header="Geçerli liste" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><ContentControl Content="{Binding GecerliListeVar}" ContentTemplate="{StaticResource RozetSablonu}" Focusable="False"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Onay" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><ContentControl Content="{Binding Onaylandi}" ContentTemplate="{StaticResource RozetSablonu}" Focusable="False"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Onaylayan" Binding="{Binding Onaylayan}" Width="*"/>
                                <DataGridTextColumn Header="Onay zamanı" Binding="{Binding OnayZamani, Converter={StaticResource YerelZaman}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
