<Window x:Class="PayControl.Desktop.Views.BordroImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bordro İçe Aktarma"
        Height="640" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Bordro Excel İçe Aktarma" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}" Margin="0,0,0,12"/>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Dosya Seç" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DosyaSecCommand}" Margin="0,0,8,0"/>
                    <Button Content="Önizle / Doğrula" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OnizleCommand}" Margin="0,0,8,0"/>
                    <Button Content="İçe Aktar" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AktarCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="360" IsReadOnly="True" Text="{Binding DosyaYolu}" Margin="0,0,12,0"/>
                    <TextBlock Text="Dönem" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="70" Text="{Binding DonemYil}" Margin="0,0,6,0"/>
                    <TextBox Width="50" Text="{Binding DonemAy}"/>
                </StackPanel>
            </DockPanel>
            <CheckBox Content="Mükerrer dosyaya rağmen yeniden aktar (önerilmez)"
                      IsChecked="{Binding MukerrereIzinVer}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource NavyBrush}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Satirlar}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding SatirNo}" Width="40"/>
                <DataGridTextColumn Header="TC" Binding="{Binding TcKimlikNo}" Width="110"/>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="140"/>
                <DataGridTextColumn Header="İşyeri" Binding="{Binding Isyeri}" Width="100"/>
                <DataGridTextColumn Header="Gün" Binding="{Binding Gun}" Width="50"/>
                <DataGridTextColumn Header="Net İstihkak" Binding="{Binding NetIstihkak, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Avans" Binding="{Binding Avans, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="İcra" Binding="{Binding Icra, StringFormat=N2}" Width="80"/>
                <DataGridCheckBoxColumn Header="Geçerli" Binding="{Binding Gecerli}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
