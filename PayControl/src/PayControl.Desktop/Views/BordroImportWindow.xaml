<Window x:Class="PayControl.Desktop.Views.BordroImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bordro İçe Aktarma"
        Height="720" Width="1120" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}">
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Bordro içe aktarma" Style="{StaticResource SayfaBasligi}"/>
            <TextBlock Text="Önce önizleyip doğrulayın; aynı dosya ikinci kez aktarılmaz. Bordrodaki avans kesintileri açık avanslara otomatik mahsup edilir."
                       Style="{StaticResource AltBaslik}"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Kart}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OnizleCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B3;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Önizle / doğrula"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AktarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="İçe aktar"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Bordro dosyası" Style="{StaticResource AlanEtiketi}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="380" IsReadOnly="True" Text="{Binding DosyaYolu}" Tag="Excel bordro dosyasını seçin"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DosyaSecCommand}" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Seç"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Bordro dönemi" Style="{StaticResource AlanEtiketi}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="70" Text="{Binding DonemYil}"/>
                                <TextBox Width="50" Margin="4,0,0,0" Text="{Binding DonemAy}"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
                <CheckBox Content="Mükerrer dosyaya rağmen yeniden aktar (önerilmez)" IsChecked="{Binding MukerrereIzinVer}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource BilgiSeridi}" Margin="0,0,0,12"
                Visibility="{Binding Mesaj, Converter={StaticResource Gorunurluk}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IkonFont}" Foreground="{StaticResource BirincilBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                <TextBlock Text="{Binding Mesaj}" Style="{StaticResource MesajYazi}" MaxWidth="980"/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Satirlar}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding SatirNo}" Width="46" ElementStyle="{StaticResource SolukHucre}"/>
                <DataGridTemplateColumn Header="Personel" Width="1.6*" SortMemberPath="AdSoyad">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AdSoyad}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TcKimlikNo}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="İşyeri" Binding="{Binding Isyeri}" Width="*"/>
                <DataGridTextColumn Header="Gün" Binding="{Binding Gun, StringFormat=0.##}" Width="60" ElementStyle="{StaticResource SagaHizali}"/>
                <DataGridTextColumn Header="Net istihkak" Binding="{Binding NetIstihkak, StringFormat=N2}" Width="120" ElementStyle="{StaticResource TutarHucre}"/>
                <DataGridTextColumn Header="Avans" Binding="{Binding Avans, StringFormat=N2}" Width="95" ElementStyle="{StaticResource SagaHizali}"/>
                <DataGridTextColumn Header="İcra" Binding="{Binding Icra, StringFormat=N2}" Width="95" ElementStyle="{StaticResource SagaHizali}"/>
                <DataGridTemplateColumn Header="Doğrulama" Width="120" SortMemberPath="Gecerli">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="b" CornerRadius="999" Padding="8,3" HorizontalAlignment="Left" Background="{StaticResource BasariYumusakBrush}">
                                <TextBlock x:Name="y" Text="Geçerli" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Gecerli}" Value="False">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource TehlikeYumusakBrush}"/>
                                    <Setter TargetName="y" Property="Text" Value="Hatalı"/>
                                    <Setter TargetName="y" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
