<Window x:Class="PayControl.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PayControl.Desktop.Controls"
        Title="Personel Yönetim Sistemi"
        Height="800" Width="1320" MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}"
        Loaded="MainWindow_OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Yan menü ============ -->
        <Border Background="{StaticResource MenuArkaBrush}">
            <DockPanel Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,20">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource MarkaGradyanBrush}">
                        <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IkonFont}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Personel Yönetim" FontFamily="{StaticResource BaslikFont}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Sistemi · 1.3.3" FontSize="11.5" Foreground="#8EA0BC" ToolTip="Sürüm 1.3.3 · Bankaya otomatik ödeme göndermez"/>
                    </StackPanel>
                </StackPanel>

                <!-- Kullanıcı kartı -->
                <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding SifreDegistirCommand}" ToolTip="Şifremi değiştir"
                                Padding="6" Foreground="#8EA0BC">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource IkonYazi}" FontSize="13"/>
                        </Button>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="38" Height="38">
                            <Ellipse Fill="{StaticResource MarkaGradyanBrush}"/>
                            <TextBlock Text="{Binding KullaniciAdi, Converter={StaticResource BasHarf}}" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KullaniciAdi}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RolEtiketi}" Foreground="#8EA0BC" FontSize="11.5"/>
                        </StackPanel>
                    </StackPanel>
                    </DockPanel>
                </Border>


                <ScrollViewer VerticalScrollBarVisibility="Auto" ClipToBounds="True" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="ANA MENÜ" FontSize="10.5" FontWeight="SemiBold" Foreground="#5F7493" Margin="8,0,0,8"/>
                    <Button Style="{StaticResource MenuButon}" Tag="secili" Command="{Binding YenileCommand}" ToolTip="Personel listesi ve hesap ekstreleri">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Personeller"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding BordroAktarCommand}" ToolTip="Aylık bordro Excel dosyasını içe aktar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Bordro İçe Aktar"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="MAAŞ DÖNEMİ" FontSize="10.5" FontWeight="SemiBold" Foreground="#5F7493" Margin="8,14,0,6"/>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding OdemeKontrolCommand}" ToolTip="Banka dosyasını göndermeden önce bordro ile karşılaştır">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Ödeme Öncesi Kontrol"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding CikisTakibiCommand}" ToolTip="Çıkış talimatları: İK çıkışı yaptı mı, sonrasında ödeme yapıldı mı">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Çıkış Takibi"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding DonemKapanisCommand}" ToolTip="Banka mutabakatı ve aylık kapanış">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Kapanış ve Mutabakat"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="RAPOR VE TAKİP" FontSize="10.5" FontWeight="SemiBold" Foreground="#5F7493" Margin="8,14,0,6"/>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding RaporMerkeziCommand}" ToolTip="18 rapor türü · Excel, PDF, CSV · e-posta / WhatsApp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Rapor Merkezi"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding UyariMerkeziCommand}" ToolTip="Tüm modüllerdeki açık işler">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E7;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Uyarı Merkezi"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding BildirimlerCommand}" ToolTip="E-posta ve WhatsApp: elle ve otomatik gönderim">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE715;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Bildirimler"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="YÖNETİM" FontSize="10.5" FontWeight="SemiBold" Foreground="#5F7493" Margin="8,14,0,6"/>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding TesislerCommand}" ToolTip="Tesis tanımları ve dönem tesis onayları">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Tesisler"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding DenetimGecmisiCommand}" ToolTip="Kim, ne zaman, neyi değiştirdi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Denetim Geçmişi"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButon}" Command="{Binding YonetimCommand}" ToolTip="Kullanıcılar, yedekleme, zamanlanmış görevler, veritabanı, güncelleme" Visibility="{Binding Yonetici, Converter={StaticResource BoolGorunur}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IkonYazi}" Margin="0,0,12,0"/>
                            <TextBlock Text="Ayarlar ve Yönetim"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ İçerik ============ -->
        <Grid Grid.Column="1" Margin="28,24,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding BordroAktarCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Bordro yükle"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OdemeKontrolCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Ödeme kontrolü başlat"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource SayfaBasligi}">
                        <Run Text="{Binding Selamlama, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding KullaniciAdi, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource AltBaslik}" Text="{Binding Bugun, Mode=OneWay}"/>
                </StackPanel>
            </DockPanel>

            <!-- KPI -->
            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,-12,16">
                <ctl:KpiKarti Baslik="Toplam personel" Deger="{Binding ToplamPersonel}" Ikon="&#xE716;" Vurgu="{StaticResource BirincilBrush}"
                              AltBilgi="Listelenen kayıt"/>
                <ctl:KpiKarti Baslik="Aktif çalışan" Deger="{Binding AktifPersonel}" Ikon="&#xE8FB;" Vurgu="{StaticResource BasariBrush}"
                              AltBilgi="Açık çalışma dönemi"/>
                <ctl:KpiKarti Baslik="İşten ayrılan" Deger="{Binding AyrilanPersonel}" Ikon="&#xE7E8;" Vurgu="{StaticResource UyariRenkBrush}"
                              AltBilgi="Geçmişi korunuyor"/>
                <ctl:KpiKarti Baslik="Aktif maaş toplamı" Deger="{Binding AylikMaasToplami}" Ikon="&#xE8C7;" Vurgu="{StaticResource MorBrush}"
                              AltBilgi="Kart üzerindeki güncel maaş"/>
                <ctl:KpiKarti Baslik="Açık uyarı" Deger="{Binding ToplamUyari}" Ikon="&#xE7E7;" Vurgu="{StaticResource TehlikeBrush}"
                              AltBilgi="{Binding KritikUyari, StringFormat={}{0} kritik}"/>
            </UniformGrid>

            <TabControl Grid.Row="2">
                <TabItem Header="Genel bakış">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kart}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource BirincilBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bordro net" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0"/>
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource BasariBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ödenen" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Aylık maaş akışı" Style="{StaticResource BolumBasligi}"/>
                                        <TextBlock Text="{Binding GrafikOzeti}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SonDonemEtiketi, StringFormat=Son bordro: {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding SonDonemNet}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource BaslikFont}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Ödenen − bordro farkı" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding SonDonemFark}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource BaslikFont}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding AylikGrafik}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" ToolTip="{Binding Ipucu}" Padding="3,0">
                                                <StackPanel>
                                                    <Grid Height="150">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                            <Border Width="12" Height="{Binding BordroYukseklik}" CornerRadius="4,4,0,0" Background="{StaticResource BirincilBrush}" Margin="0,0,3,0"
                                                                    VerticalAlignment="Bottom"/>
                                                            <Border Width="12" Height="{Binding OdenenYukseklik}" CornerRadius="4,4,0,0" Background="{StaticResource BasariBrush}"
                                                                    VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Height="1" Background="{StaticResource SatirCizgiBrush}"/>
                                                    <TextBlock Text="{Binding Etiket}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Kart}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding TesislerCommand}" Padding="8,4">
                                        <TextBlock Text="Tesisler" FontSize="12"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Tesis dağılımı" Style="{StaticResource BolumBasligi}"/>
                                        <TextBlock Text="Son bordro dönemi, net tutara göre" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding TesisPaylari}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Yuzde}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Tesis}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <Border Height="8" CornerRadius="4" Background="{StaticResource YuzeyIkincilBrush}" Margin="0,6,0,4">
                                                    <Border Width="{Binding Genislik}" CornerRadius="4" Background="{StaticResource MarkaGradyanBrush}" HorizontalAlignment="Left"/>
                                                </Border>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tutar}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding Personel}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Personeller">
            <!-- Personel tablosu -->
            <Border Style="{StaticResource Kart}" Padding="0" Margin="0,14,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,16,18,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Style="{StaticResource AramaKutusu}" Width="280" Tag="Ad, TC veya sicil ara…"
                                     Text="{Binding Arama, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding YenileCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBox Width="140" Margin="8,0,0,0" Tag="Şirket" Text="{Binding FiltreSirket, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding YenileCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBox Width="140" Margin="8,0,0,0" Tag="Tesis / işyeri" Text="{Binding FiltreIsyeri, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding YenileCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding YenileCommand}" ToolTip="Listeyi yenile">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IkonYazi}" FontSize="13"/>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Personel listesi" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Satıra çift tıklayarak personel kartını ve hesap ekstresini açın" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding Personeller}" SelectedItem="{Binding SeciliPersonel}" BorderThickness="0,1,0,0"
                              MinRowHeight="52" MouseDoubleClick="PersonelGrid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Personel" Width="2.4*" SortMemberPath="AdSoyad">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{Binding AdSoyad}" ContentTemplate="{StaticResource AvatarSablonu}" Margin="0,0,12,0" Focusable="False"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AdSoyad}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TcKimlikNo}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sicil" Binding="{Binding SicilNo}" Width="0.8*" ElementStyle="{StaticResource SolukHucre}"/>
                            <DataGridTextColumn Header="Şirket" Binding="{Binding Sirket}" Width="1.2*"/>
                            <DataGridTextColumn Header="Tesis / işyeri" Binding="{Binding Isyeri}" Width="1.2*"/>
                            <DataGridTextColumn Header="Görevi" Binding="{Binding Gorevi}" Width="*" ElementStyle="{StaticResource SolukHucre}"/>
                            <DataGridTemplateColumn Header="Durum" Width="140" SortMemberPath="CalismaDurumu">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding CalismaDurumu}" ContentTemplate="{StaticResource RozetSablonu}" Focusable="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IkonFont}" FontSize="12" Foreground="{StaticResource SolukYaziBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="3" Text="{Binding DurumMetni}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="4,10,0,0"/>
        </Grid>
    </Grid>
</Window>
