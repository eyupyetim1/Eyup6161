<Window x:Class="PayControl.Desktop.Views.IstenCikisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşten Çıkış Kaydı"
        Height="760" Width="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}">
    <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="İşten çıkış kaydı" Style="{StaticResource SayfaBasligi}"/>
            <TextBlock Text="{Binding PersonelAd}" Style="{StaticResource AltBaslik}" Margin="0,4,0,18"/>
            <Border Style="{StaticResource Kart}" Margin="0,0,0,14">
            <StackPanel>

            <TextBlock Text="Fiilî son çalışma tarihi" Style="{StaticResource AlanEtiketi}"/>
            <DatePicker SelectedDate="{Binding FiiliSonCalisma}" Margin="0,4,0,10"/>

            <TextBlock Text="İşten çıkış tarihi" Style="{StaticResource AlanEtiketi}"/>
            <DatePicker SelectedDate="{Binding IstenCikisTarihi}" Margin="0,4,0,10"/>

            <TextBlock Text="Çıkış nedeni" Style="{StaticResource AlanEtiketi}"/>
            <TextBox Text="{Binding CikisNedeni, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Son bordro yılı" Style="{StaticResource AlanEtiketi}"/>
                    <TextBox Text="{Binding SonBordroYil}" Margin="0,4,8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Son bordro ayı" Style="{StaticResource AlanEtiketi}"/>
                    <TextBox Text="{Binding SonBordroAy}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Son maaş ödeme durumu" Style="{StaticResource AlanEtiketi}"/>
            <ComboBox ItemsSource="{Binding SonMaasDurumlari}" SelectedItem="{Binding SonMaasDurumu}" Margin="0,4,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Kalan avans" Style="{StaticResource AlanEtiketi}"/>
                    <TextBox Text="{Binding KalanAvans}" Margin="0,4,8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="İzin ücreti" Style="{StaticResource AlanEtiketi}"/>
                    <TextBox Text="{Binding IzinUcreti}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Kıdem tazminatı" Style="{StaticResource AlanEtiketi}"/>
                    <TextBox Text="{Binding Kidem}" Margin="0,4,8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="İhbar tazminatı" Style="{StaticResource AlanEtiketi}"/>
                    <TextBox Text="{Binding Ihbar}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Açıklama" Style="{StaticResource AlanEtiketi}"/>
            <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}"
                     Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,12"/>

            </StackPanel>
            </Border>
            <Border Style="{StaticResource UyariSeridi}" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SGK işten ayrılış bildirgesi"
                               FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                    <TextBlock Text="Program kendiliğinden bildirim yapıldığını varsaymaz. Yalnızca sizin onayınız veya belge ile işaretlenir."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                    <CheckBox Content="SGK çıkış bildirgesi verildi — onaylıyorum"
                              IsChecked="{Binding SgkVerildiOnay}"/>
                    <TextBlock Text="Bildirge tarihi" Margin="0,8,0,4"/>
                    <DatePicker SelectedDate="{Binding SgkBildirgeTarihi}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Uyari}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Hata}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç" Style="{StaticResource SecondaryButton}" Click="Iptal_Click" Margin="0,0,8,0"/>
                <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding KaydetCommand}"
                        Click="Kaydet_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
