<Window x:Class="PayControl.Desktop.Views.OdemeKontrolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ödeme Öncesi Kontrol — Bankaya Göndermeden Önce"
        Height="780" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Banka ödeme listesi kontrolü" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
            <TextBlock Text="1) Bordro dosyası  2) Bankaya gönderilecek dosya  3) Kontrol  4) Düzelt / gerekçeli istisna  5) Onaylı liste. Program bankaya ödeme göndermez."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
            <WrapPanel>
                <TextBlock Text="Dönem" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="60" Text="{Binding DonemYil}" Margin="0,0,4,0"/>
                <TextBox Width="36" Text="{Binding DonemAy}" Margin="0,0,12,0"/>
                <TextBox Width="250" IsReadOnly="True" Text="{Binding BordroDosyaYolu}" ToolTip="Boş bırakılırsa dönemin içe aktarılmış son bordrosu kullanılır"/>
                <Button Content="Bordro Seç" Style="{StaticResource SecondaryButton}" Command="{Binding BordroSecCommand}" Margin="4,0,12,0"/>
                <TextBox Width="250" IsReadOnly="True" Text="{Binding BankaDosyaYolu}"/>
                <Button Content="Banka Dosyası Seç" Style="{StaticResource SecondaryButton}" Command="{Binding DosyaSecCommand}" Margin="4,0,12,0"/>
                <Button Content="Kontrol Et" Style="{StaticResource PrimaryButton}" Command="{Binding KontrolEtCommand}" Margin="0,0,6,0"/>
                <Button Content="Yeniden Değerlendir" Style="{StaticResource SecondaryButton}" Command="{Binding YenidenDegerlendirCommand}" Margin="0,0,6,0"/>
                <Button Content="Onaylı Liste Oluştur" Style="{StaticResource PrimaryButton}" Command="{Binding OnayliListeUretCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding OzetMetni}" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource NavyBrush}"/>
            <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource NavyBrush}"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Seçili satırı düzelt:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="IBAN" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="250" Text="{Binding DuzeltIban, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Tutar" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox Width="100" Text="{Binding DuzeltTutar}"/>
                    <CheckBox Content="Listeden çıkar" IsChecked="{Binding DuzeltHaric}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Width="260" Margin="8,0,0,0" Text="{Binding DuzeltGerekce, UpdateSourceTrigger=PropertyChanged}" ToolTip="Düzeltme gerekçesi (zorunlu)"/>
                    <Button Content="Düzelt ve Yeniden Kontrol Et" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DuzeltCommand}"/>
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="Gerekçeli istisna (yalnızca Yönetici; kimlik/ödeme sahibi belirsiz satırlar onaylanamaz):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="420" Text="{Binding IstisnaGerekce, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="İstisna Onayla" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding IstisnaOnaylaCommand}"/>
                </WrapPanel>
                <TextBlock Text="Seçili satır gerekçesi:" FontWeight="SemiBold" Margin="0,8,0,2"/>
                <TextBlock Text="{Binding SeciliSatir.Gerekce}" TextWrapping="Wrap" MaxHeight="80"/>
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="Kontrol sonuçları">
                <DataGrid ItemsSource="{Binding Satirlar}" SelectedItem="{Binding SeciliSatir}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TC" Binding="{Binding TcKimlikNo}" Width="100"/>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="140"/>
                        <DataGridTextColumn Header="Banka satırı" Binding="{Binding TalimatSatirNolari}" Width="70"/>
                        <DataGridTextColumn Header="Bordro net" Binding="{Binding BordroNetIstihkak, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Banka" Binding="{Binding BankaOdemeTutari, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Kart IBAN" Binding="{Binding KartIban}" Width="190"/>
                        <DataGridTextColumn Header="Banka IBAN" Binding="{Binding BankaIban}" Width="190"/>
                        <DataGridTextColumn Header="Sonuç" Binding="{Binding Sonuc}" Width="130"/>
                        <DataGridCheckBoxColumn Header="Kritik" Binding="{Binding KritikMi}" Width="50"/>
                        <DataGridCheckBoxColumn Header="Belirsiz" Binding="{Binding EslesmeBelirsiz}" Width="55"/>
                        <DataGridCheckBoxColumn Header="İstisna" Binding="{Binding IstisnaOnayi}" Width="55"/>
                        <DataGridTextColumn Header="Gerekçe" Binding="{Binding Gerekce}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Onaylı liste sürümleri">
                <DataGrid ItemsSource="{Binding Listeler}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sürüm" Binding="{Binding Surum}" Width="60"/>
                        <DataGridCheckBoxColumn Header="Geçerli" Binding="{Binding Gecerli}" Width="60"/>
                        <DataGridTextColumn Header="Dosya" Binding="{Binding DosyaAdi}" Width="200"/>
                        <DataGridTextColumn Header="Satır" Binding="{Binding SatirSayisi}" Width="50"/>
                        <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamTutar, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Bordro" Binding="{Binding BordroDosyaAdi}" Width="150"/>
                        <DataGridTextColumn Header="Oluşturan" Binding="{Binding OlusturanKullanici}" Width="90"/>
                        <DataGridTextColumn Header="Zaman" Binding="{Binding OlusturmaZamani, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="Geçersizlik nedeni" Binding="{Binding GecersizlikNedeni}" Width="*"/>
                        <DataGridTextColumn Header="SHA-256" Binding="{Binding DosyaHashSha256}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
