<Window x:Class="PayControl.Desktop.Views.OdemeKontrolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ödeme Öncesi Kontrol — Bankaya Göndermeden Önce"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Banka ödeme listesi kontrolü" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource NavyBrush}"/>
            <TextBlock Text="Program bankaya ödeme göndermez. Yalnızca kontrol edilmiş onaylı dosya üretir."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Kontrol Et" Style="{StaticResource PrimaryButton}"
                            Command="{Binding KontrolEtCommand}" Margin="0,0,8,0"/>
                    <Button Content="İstisna Onayla" Style="{StaticResource SecondaryButton}"
                            Command="{Binding IstisnaOnaylaCommand}" Margin="0,0,8,0"/>
                    <Button Content="Onaylı Liste Oluştur" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OnayliListeUretCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dönem" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="70" Text="{Binding DonemYil}" Margin="0,0,6,0"/>
                    <TextBox Width="40" Text="{Binding DonemAy}" Margin="0,0,12,0"/>
                    <TextBox Width="320" IsReadOnly="True" Text="{Binding BankaDosyaYolu}" Margin="0,0,8,0"/>
                    <Button Content="Banka Excel Seç" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DosyaSecCommand}"/>
                </StackPanel>
            </DockPanel>
            <TextBox Margin="0,8,0,0" Text="{Binding IstisnaGerekce, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Seçili kritik satır için istisna gerekçesi"/>
            <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource NavyBrush}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Satirlar}" SelectedItem="{Binding SeciliSatir}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TC" Binding="{Binding TcKimlikNo}" Width="110"/>
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="140"/>
                <DataGridTextColumn Header="Bordro" Binding="{Binding BordroNetIstihkak, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Banka" Binding="{Binding BankaOdemeTutari, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Sonuç" Binding="{Binding Sonuc}" Width="140"/>
                <DataGridCheckBoxColumn Header="Kritik" Binding="{Binding KritikMi}" Width="60"/>
                <DataGridCheckBoxColumn Header="Belirsiz" Binding="{Binding EslesmeBelirsiz}" Width="70"/>
                <DataGridCheckBoxColumn Header="İstisna" Binding="{Binding IstisnaOnayi}" Width="70"/>
                <DataGridTextColumn Header="Gerekçe" Binding="{Binding Gerekce}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
