<Window x:Class="PayControl.Desktop.Views.OdemeKontrolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PayControl.Desktop.Controls"
        Title="Ödeme Öncesi Kontrol — Bankaya göndermeden önce"
        Height="880" Width="1380" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}">
    <Window.Resources>
        <!-- Kritik ve çözülmemiş satırlar kırmızımsı, istisnalı satırlar mor tonda -->
        <Style x:Key="KontrolSatiri" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding KritikMi}" Value="True"/>
                        <Condition Binding="{Binding IstisnaOnayi}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFBFA"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IstisnaOnayi}" Value="True">
                    <Setter Property="Background" Value="#FBFAFF"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverSatirBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SeciliSatirBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,20,24,20">
        <!-- ============ Başlık ve adımlar ============ -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Style="{StaticResource UyariSeridi}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IkonFont}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Program bankaya ödeme göndermez; yalnızca onaylı dosya üretir." Foreground="{StaticResource WarnBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Ödeme öncesi kontrol" Style="{StaticResource SayfaBasligi}"/>
                <ItemsControl ItemsSource="{Binding Adimlar}" ItemTemplate="{StaticResource AsamaSablonu}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DockPanel>

        <!-- ============ Dosyalar ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Kart}" Padding="16,14" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding KontrolEtCommand}" Margin="0,0,8,0" MinHeight="38">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource IkonYazi}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Kontrol et"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding YenidenDegerlendirCommand}" Margin="0,0,8,0" MinHeight="38"
                            ToolTip="Güncel verilerle (yeni ödeme, çıkış kaydı…) yeniden değerlendir">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IkonYazi}" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource BasariButton}" Command="{Binding OnayliListeUretCommand}" MinHeight="38">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IkonYazi}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Onaylı liste oluştur"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Dönem" Style="{StaticResource AlanEtiketi}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="68" Text="{Binding DonemYil}"/>
                            <TextBox Width="46" Margin="4,0,0,0" Text="{Binding DonemAy}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Tesis" Style="{StaticResource AlanEtiketi}"/>
                        <ComboBox Width="170" ItemsSource="{Binding Tesisler}" SelectedItem="{Binding SeciliTesis}"
                                  ToolTip="Tesis seçilirse yalnız o tesisin bordrosu ile o tesisin banka dosyası karşılaştırılır; her tesisin ayrı onaylı listesi olur"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="1 · Bordro dosyası" Style="{StaticResource AlanEtiketi}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="240" IsReadOnly="True" Text="{Binding BordroDosyaYolu}" Tag="Dönemin son yüklenen bordrosu kullanılır"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding BordroSecCommand}" Margin="6,0,0,0" ToolTip="Bordro Excel seç">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource IkonYazi}" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="2 · Bankaya gönderilecek dosya" Style="{StaticResource AlanEtiketi}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="240" IsReadOnly="True" Text="{Binding BankaDosyaYolu}" Tag="Banka ödeme Excel'ini seçin"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DosyaSecCommand}" Margin="6,0,0,0" ToolTip="Banka Excel seç">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource IkonYazi}" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============ KPI ============ -->
        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,-12,14">
            <ctl:KpiKarti Baslik="Kontrol edilen satır" Deger="{Binding SatirSayisi}" Ikon="&#xE8FD;" Vurgu="{StaticResource BirincilBrush}"/>
            <ctl:KpiKarti Baslik="Uygun" Deger="{Binding UygunSayisi}" Ikon="&#xE73E;" Vurgu="{StaticResource BasariBrush}"/>
            <ctl:KpiKarti Baslik="Çözülmemiş kritik" Deger="{Binding KritikSayisi}" Ikon="&#xE7BA;" Vurgu="{StaticResource TehlikeBrush}"
                          AltBilgi="Liste üretimini engeller"/>
            <ctl:KpiKarti Baslik="Gerekçeli istisna" Deger="{Binding IstisnaSayisi}" Ikon="&#xE8D7;" Vurgu="{StaticResource MorBrush}"/>
            <ctl:KpiKarti Baslik="Banka dosyası toplamı" Deger="{Binding BankaToplami}" AltBilgi="{Binding BankaToplamAlt}" Ikon="&#xE8C7;" Vurgu="#0BA5EC"/>
        </UniformGrid>

        <Border DockPanel.Dock="Top" Style="{StaticResource BilgiSeridi}" Margin="0,0,0,12"
                Visibility="{Binding Mesaj, Converter={StaticResource Gorunurluk}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IkonFont}" Foreground="{StaticResource BirincilBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                <TextBlock Text="{Binding Mesaj}" Style="{StaticResource MesajYazi}" MaxWidth="1150"/>
            </StackPanel>
        </Border>

        <!-- ============ Sonuçlar + seçili satır paneli ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <TabControl Padding="0,10,0,0">
                <TabItem Header="Kontrol sonuçları">
                    <DataGrid ItemsSource="{Binding Satirlar}" SelectedItem="{Binding SeciliSatir}" RowStyle="{StaticResource KontrolSatiri}" MinRowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Personel" Width="1.6*" SortMemberPath="AdSoyad">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AdSoyad, TargetNullValue=Kimliği belirsiz}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}">
                                                <Run Text="{Binding TcKimlikNo, Mode=OneWay, TargetNullValue=TC yok}"/><Run Text="  ·  satır "/><Run Text="{Binding TalimatSatirNolari, Mode=OneWay, TargetNullValue=—}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Sonuç" Width="170" SortMemberPath="Sonuc">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding Sonuc}" ContentTemplate="{StaticResource RozetSablonu}" Focusable="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Bordro net" Binding="{Binding BordroNetIstihkak, StringFormat=N2}" Width="100" ElementStyle="{StaticResource SagaHizali}"/>
                            <DataGridTextColumn Header="Banka" Binding="{Binding BankaOdemeTutari, StringFormat=N2}" Width="100" ElementStyle="{StaticResource SagaHizali}"/>
                            <DataGridTemplateColumn Header="Bayraklar" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="6" Padding="6,2" Margin="0,0,4,0" Background="{StaticResource TehlikeYumusakBrush}"
                                                    Visibility="{Binding KritikMi, Converter={StaticResource BoolGorunur}}" ToolTip="Kritik uyarı">
                                                <TextBlock Text="Kritik" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                            </Border>
                                            <Border CornerRadius="6" Padding="6,2" Margin="0,0,4,0" Background="{StaticResource UyariYumusakBrush}"
                                                    Visibility="{Binding EslesmeBelirsiz, Converter={StaticResource BoolGorunur}}" ToolTip="Kimlik / ödeme sahibi belirsiz — istisna verilemez">
                                                <TextBlock Text="Belirsiz" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                                            </Border>
                                            <Border CornerRadius="6" Padding="6,2" Background="{StaticResource MorYumusakBrush}"
                                                    Visibility="{Binding IstisnaOnayi, Converter={StaticResource BoolGorunur}}" ToolTip="{Binding IstisnaGerekcesi}">
                                                <TextBlock Text="İstisna" FontSize="11" FontWeight="SemiBold" Foreground="#5925DC"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Gerekçe" Binding="{Binding Gerekce}" Width="2.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Foreground" Value="{StaticResource IkincilYaziBrush}"/>
                                        <Setter Property="ToolTip" Value="{Binding Gerekce}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Onaylı liste sürümleri">
                    <DataGrid ItemsSource="{Binding Listeler}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sürüm" Binding="{Binding Surum, StringFormat=v{0}}" Width="70"/>
                            <DataGridTemplateColumn Header="Geçerli" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding Gecerli}" ContentTemplate="{StaticResource RozetSablonu}" Focusable="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dosya" Binding="{Binding DosyaAdi}" Width="1.4*"/>
                            <DataGridTextColumn Header="Satır" Binding="{Binding SatirSayisi}" Width="60" ElementStyle="{StaticResource SagaHizali}"/>
                            <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamTutar, StringFormat=N2}" Width="110" ElementStyle="{StaticResource SagaHizali}"/>
                            <DataGridTextColumn Header="Bordro" Binding="{Binding BordroDosyaAdi}" Width="*" ElementStyle="{StaticResource SolukHucre}"/>
                            <DataGridTextColumn Header="Oluşturan" Binding="{Binding OlusturanKullanici}" Width="90"/>
                            <DataGridTextColumn Header="Zaman" Binding="{Binding OlusturmaZamani, StringFormat=dd.MM.yyyy HH:mm}" Width="120" ElementStyle="{StaticResource SolukHucre}"/>
                            <DataGridTextColumn Header="Geçersizlik nedeni" Binding="{Binding GecersizlikNedeni}" Width="1.4*" ElementStyle="{StaticResource SolukHucre}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- Seçili satır paneli -->
            <Border Grid.Column="2" Style="{StaticResource Kart}" Padding="0" Margin="0,46,0,0">
                <Grid>
                    <!-- Seçim yokken -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding SeciliSatir, Converter={StaticResource Gorunurluk}, ConverterParameter=ters}">
                        <Grid Width="56" Height="56" HorizontalAlignment="Center">
                            <Ellipse Fill="{StaticResource BirincilYumusakBrush}"/>
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IkonFont}" FontSize="22" Foreground="{StaticResource BirincilBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Bir satır seçin" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="Bulguları görmek, banka talimatını düzeltmek veya gerekçeli istisna vermek için tablodan bir satır seçin."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SeciliSatir, Converter={StaticResource Gorunurluk}}">
                        <StackPanel Margin="18">
                            <TextBlock Text="{Binding SeciliSatir.AdSoyad, TargetNullValue=Kimliği belirsiz kayıt}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ContentControl Content="{Binding SeciliSatir.Sonuc}" ContentTemplate="{StaticResource RozetSablonu}" Margin="0,8,0,14" Focusable="False"/>

                            <Border Style="{StaticResource IcKart}" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Bordro net" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding SeciliSatir.BordroNetIstihkak, StringFormat=N2, TargetNullValue=—}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Banka talimatı" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding SeciliSatir.BankaOdemeTutari, StringFormat=N2, TargetNullValue=—}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Kart IBAN" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding SeciliSatir.KartIban, TargetNullValue=—}" FontFamily="Consolas, Segoe UI" Margin="0,2,0,8"/>
                            <TextBlock Text="Banka IBAN" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding SeciliSatir.BankaIban, TargetNullValue=—}" FontFamily="Consolas, Segoe UI" Margin="0,2,0,14"/>

                            <TextBlock Text="Bulgular" Style="{StaticResource BolumBasligi}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SeciliSatir.Gerekce}" TextWrapping="Wrap" Foreground="{StaticResource IkincilYaziBrush}" LineHeight="19" Margin="0,0,0,18"/>

                            <TextBlock Text="Banka talimatını düzelt" Style="{StaticResource BolumBasligi}" Margin="0,0,0,8"/>
                            <TextBlock Text="IBAN" Style="{StaticResource AlanEtiketi}"/>
                            <TextBox Text="{Binding DuzeltIban, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Segoe UI" Margin="0,0,0,10"/>
                            <TextBlock Text="Tutar" Style="{StaticResource AlanEtiketi}"/>
                            <TextBox Text="{Binding DuzeltTutar}" Margin="0,0,0,10"/>
                            <CheckBox Content="Bu talimatı listeden çıkar" IsChecked="{Binding DuzeltHaric}" Margin="0,0,0,10"/>
                            <TextBox Tag="Düzeltme gerekçesi (zorunlu)" Text="{Binding DuzeltGerekce, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DuzeltCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Düzelt ve yeniden kontrol et"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Gerekçeli istisna" Style="{StaticResource BolumBasligi}" Margin="0,0,0,4"/>
                            <TextBlock Text="Yalnızca Yönetici verebilir. Kimlik veya ödeme sahibi belirsiz satırlara istisna verilemez."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBox Tag="İstisna gerekçesi (en az 10 karakter)" Text="{Binding IstisnaGerekce, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" VerticalContentAlignment="Top" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding IstisnaOnaylaCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource IkonYazi}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="İstisna onayla"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
