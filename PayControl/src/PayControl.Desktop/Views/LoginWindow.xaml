<Window x:Class="PayControl.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PayControl — Giriş"
        Height="360" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="PayControl" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource NavyBrush}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Personel Mali Denetim Sistemi"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24"/>
        <TextBlock Grid.Row="2" Text="Kullanıcı adı" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,20,0,12"/>
        <TextBlock Grid.Row="3" Text="Şifre" Margin="0,0,0,4"/>
        <PasswordBox x:Name="SifreBox" Grid.Row="3" Margin="0,20,0,12"
                     PasswordChanged="SifreBox_OnPasswordChanged"/>
        <TextBlock Grid.Row="4" Text="{Binding HataMesaji}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12" MinHeight="20"/>
        <Button Grid.Row="5" Content="Giriş Yap" Style="{StaticResource PrimaryButton}"
                Command="{Binding GirisCommand}" HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
