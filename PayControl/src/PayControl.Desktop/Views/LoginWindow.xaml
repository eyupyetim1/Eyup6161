<Window x:Class="PayControl.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PayControl — Giriş"
        Height="540" Width="880"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AnaFont}"
        Background="{StaticResource ZeminBrush}"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Marka paneli -->
        <Border Background="{StaticResource GirisArkaBrush}">
            <Grid Margin="40">
                <Ellipse Width="320" Height="320" Fill="White" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-170,-150"/>
                <Ellipse Width="180" Height="180" Fill="White" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-60,0"/>
                <StackPanel VerticalAlignment="Top">
                    <Border Width="52" Height="52" CornerRadius="15" Background="#26FFFFFF" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IkonFont}" FontSize="24" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PayControl" FontFamily="{StaticResource BaslikFont}" FontSize="32" FontWeight="SemiBold"
                               Foreground="White" Margin="0,24,0,0"/>
                    <TextBlock Text="Personel mali denetim ve maaş ödeme kontrol sistemi" FontSize="14" Foreground="#C7D2FE"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IkonFont}" Foreground="#86EFAC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="İşe girişten bugüne belgeli hesap ekstresi" Foreground="#E0E7FF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IkonFont}" Foreground="#86EFAC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Bankaya göndermeden önce hatalı ödeme kontrolü" Foreground="#E0E7FF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IkonFont}" Foreground="#86EFAC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Mutabakat ve güvenli aylık kapanış" Foreground="#E0E7FF"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Giriş formu -->
        <Grid Grid.Column="1">
            <StackPanel Width="340" VerticalAlignment="Center">
                <TextBlock Text="Tekrar hoş geldiniz" Style="{StaticResource SayfaBasligi}" FontSize="26"/>
                <TextBlock Text="Devam etmek için hesabınızla giriş yapın." Style="{StaticResource AltBaslik}" Margin="0,6,0,28"/>

                <TextBlock Text="Kullanıcı adı" Style="{StaticResource AlanEtiketi}"/>
                <TextBox Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}" Tag="kullanıcı adınız" MinHeight="40" Margin="0,0,0,16"/>

                <TextBlock Text="Şifre" Style="{StaticResource AlanEtiketi}"/>
                <PasswordBox x:Name="SifreBox" MinHeight="40" PasswordChanged="SifreBox_OnPasswordChanged" Margin="0,0,0,10"/>

                <Border Style="{StaticResource UyariSeridi}" Background="{StaticResource TehlikeYumusakBrush}" BorderBrush="#FECDCA" Margin="0,4,0,0"
                        Visibility="{Binding HataMesaji, Converter={StaticResource Gorunurluk}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="{StaticResource IkonFont}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="290"/>
                    </StackPanel>
                </Border>

                <Button Content="Giriş yap" Style="{StaticResource PrimaryButton}" Command="{Binding GirisCommand}" IsDefault="True"
                        HorizontalAlignment="Stretch" MinHeight="42" FontSize="14" Margin="0,18,0,0"/>
                <TextBlock Text="İlk kurulumda kullanıcı: admin" FontSize="11.5" Foreground="{StaticResource SolukYaziBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
